node_modules/
*.tsbuildinfo
.turbo/
plans/
dist/
build/
out/
release/
release-*/
.cache/
/.artifacts/
/.pnpm-store/
playwright-report/
test-results/
.claude/worktrees/
.codex/worktrees/
.worktrees/
.DS_Store

# Vite dev build artifacts
*.js
*.css
!/apps/**/*.js
!/apps/**/*.css
!/packages/**/*.js
!/packages/**/*.css
!/extensions/**/*.js
!/extensions/**/*.css
index.html
!apps/**/index.html

# Vite hashed build output (anywhere)
*-[A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9].js
*-[A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9].css

# Extension build output
extensions/*/dist/

# Vendored genoffice sources are checked in, so a clone builds with no upstream
# checkout. Placed after the `*.js` rule so the few plain-JS files they ship
# survive; node_modules and build output stay ignored.
!vendor/**/*.js
